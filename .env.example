PORT=8000
# Choose a password before first PostgreSQL startup; keep it for this volume.
POSTGRES_PASSWORD=
# Local development with compose.dev.yaml (Docker overrides these internally).
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=chess
PGDATABASE=chess_study
PGPASSWORD=${POSTGRES_PASSWORD}
# Optional: a recognizable application name and contact for Chess.com's API.
CHESSCOM_USER_AGENT=ChessStudy/0.1 (local game library)

# Backend coach only. Never put this key in a VITE_ variable or frontend source.
OPENAI_API_KEY=
# Includes reasoning tokens as well as the visible answer.
COACH_MAX_OUTPUT_TOKENS=32768
COACH_TIMEOUT_SECONDS=600

# Optional LangSmith tracing for app, CLI, and Studio graph runs.
# Set true after adding your key. Trace data includes prompts and model outputs.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chess-coach
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# For an API key linked to multiple workspaces, set the target workspace ID.
# LANGSMITH_WORKSPACE_ID=
